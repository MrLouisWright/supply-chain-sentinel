{
  "name": "supply-chain-sentinel",
  "version": "1.0.0",
  "description": "One supply-chain gate for npm projects: runs package-tripwire (risky dependency changes), license-sentinel (license policy), sbom-diff-sentinel (new vulnerabilities and SBOM drift) and workflow-sentinel (GitHub Actions hardening) with one config, one combined report (text, JSON, SARIF, Markdown) and one exit code.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "supply-chain-sentinel": "bin/supply-chain-sentinel.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "supply-chain",
    "supply-chain-security",
    "dependencies",
    "npm",
    "lockfile",
    "license",
    "sbom",
    "cyclonedx",
    "github-actions",
    "osv",
    "devsecops",
    "security",
    "sarif",
    "cli",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/supply-chain-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/supply-chain-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/supply-chain-sentinel/",
  "dependencies": {
    "license-sentinel": "^1.1.0",
    "package-tripwire": "^1.1.0",
    "sbom-diff-sentinel": "^1.1.0",
    "workflow-sentinel": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
